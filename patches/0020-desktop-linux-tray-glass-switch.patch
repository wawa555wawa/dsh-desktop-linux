+/**
+ * Persist the glass-mode switch, keeping every other field of the document untouched.
+ *
+ * The tray menu owns this switch. A shell relaunch applies it because the window's transparency and
+ * frame are creation-time options; readers of the file (`readDesktopSettings`) never write it back.
+ * @param userData - Electron's userData directory, independent of DSH_HOME.
+ * @param glass - Whether the next launch should start in glass mode.
+ */
+export function writeDesktopGlassPreference(userData: string, glass: boolean): void {
+  const directory = join(userData, 'desktop')
+  const path = join(directory, 'settings.json')
+  let document: Record<string, unknown> = {}
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(path, 'utf8'))
+    if (record(parsed)) document = parsed
+  } catch (error) {
+    // A missing file is the first-launch case; anything else (unreadable or unparseable) must not be
+    // rewritten, or a user's broken document would lose its updates preference.
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+  }
+  const appearance = record(document.appearance) ? document.appearance : {}
+  document.appearance = { ...appearance, glass }
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  writeFileSync(path, `${JSON.stringify(document, null, 2)}\n`, { mode: 0o600 })
